<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="J;Y6:7=}ESzpUZMr+907" x="697" y="0"><statement name="HANDLER"><block type="typescript_statement" id="b`R-TV5a8-h!;qz5Xtbl"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace paj7620 {" line1="    const PAJ7620_I2C_ADDR = 0x73; // כתובת ה-I2C של חיישן המחושים" line2="" line3="    // בחירת בנק זיכרון" line4="    const PAJ7620_REGITER_BANK_SEL = 0xEF;" line5="    const PAJ7620_BANK0 = 0x00;" line6="    const PAJ7620_BANK1 = 0x01;" line7="" line8="    // קודי זיהוי תנועות מתוך רגיסטרי החיישן" line9="    const GES_UP = 0x01;" line10="    const GES_DOWN = 0x02;" line11="    const GES_LEFT = 0x04;" line12="    const GES_RIGHT = 0x08;" line13="    const GES_FORWARD = 0x10;" line14="    const GES_BACKWARD = 0x20;" line15="    const GES_CLOCKWISE = 0x40;" line16="    const GES_COUNT_CLOCKWISE = 0x80;" line17="    const GES_WAVE = 0x100;" line18="" line19="    function writeReg(addr: number, val: number) {" line20="        let buf = pins.createBuffer(2);" line21="        buf[0] = addr;" line22="        buf[1] = val;" line23="        pins.i2cWriteBuffer(PAJ7620_I2C_ADDR, buf);" line24="    }" line25="" line26="    function readReg(addr: number): number {" line27="        pins.i2cWriteNumber(PAJ7620_I2C_ADDR, addr, NumberFormat.UInt8BE, false);" line28="        return pins.i2cReadNumber(PAJ7620_I2C_ADDR, NumberFormat.UInt8BE, false);" line29="    }" line30="" line31="    /**" line32="     * אתחול חיישן המחושים PAJ7620" line33="     */" line34="    //% block=&quot;אתחל חיישן מחושים PAJ7620&quot;" line35="    //% weight=100" line36="    export function init(): void {" line37="        writeReg(PAJ7620_REGITER_BANK_SEL, PAJ7620_BANK0);" line38="        basic.pause(50);" line39="    }" line40="" line41="    /**" line42="     * מחזיר את סוג התנועה האחרונה שזוהתה באוויר" line43="     */" line44="    //% block=&quot;תנועה שזוהתה בחיישן המחושים&quot;" line45="    //% weight=90" line46="    export function getGesture(): GestureType {" line47="        writeReg(PAJ7620_REGITER_BANK_SEL, PAJ7620_BANK0);" line48="        let data = readReg(0x43);" line49="        let data2 = readReg(0x44);" line50="" line51="        let val = data | (data2 &lt;&lt; 8);" line52="" line53="        if (val == GES_UP) return GestureType.Up;" line54="        if (val == GES_DOWN) return GestureType.Down;" line55="        if (val == GES_LEFT) return GestureType.Left;" line56="        if (val == GES_RIGHT) return GestureType.Right;" line57="        if (val == GES_FORWARD) return GestureType.Forward;" line58="        if (val == GES_BACKWARD) return GestureType.Backward;" line59="        if (val == GES_CLOCKWISE) return GestureType.Clockwise;" line60="        if (val == GES_COUNT_CLOCKWISE) return GestureType.CounterClockwise;" line61="        if (val == GES_WAVE) return GestureType.Wave;" line62="" line63="        return GestureType.None;" line64="    }" line65="" line66="    /**" line67="     * בודק האם תנועה ספציפית זוהתה כרגע (מחזיר אמת או שקר)" line68="     * @param gesture סוג התנועה לבדיקה" line69="     */" line70="    //% block=&quot;האם זוהתה תנועה %gesture&quot;" line71="    //% weight=85" line72="    export function isGesture(gesture: GestureType): boolean {" line73="        return getGesture() === gesture;" line74="    }" line75="" line76="    export enum GestureType {" line77="        //% block=&quot;ללא&quot;" line78="        None = 0," line79="        //% block=&quot;למעלה&quot;" line80="        Up = 1," line81="        //% block=&quot;למטה&quot;" line82="        Down = 2," line83="        //% block=&quot;שמאלה&quot;" line84="        Left = 3," line85="        //% block=&quot;ימינה&quot;" line86="        Right = 4," line87="        //% block=&quot;קדימה&quot;" line88="        Forward = 5," line89="        //% block=&quot;אחורה&quot;" line90="        Backward = 6," line91="        //% block=&quot;בכיוון השעון&quot;" line92="        Clockwise = 7," line93="        //% block=&quot;נגד כיוון השעון&quot;" line94="        CounterClockwise = 8," line95="        //% block=&quot;נפנוף&quot;" line96="        Wave = 9" line97="    }" line98="}" numlines="99"></mutation><next><block type="typescript_statement" id="WYkP~QbaKZ~0AxxL!GCH"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace yahboomTracker {" line1="    const MODULE_ADDRESS = 0x12; // כתובת ה-I2C של המודול[cite: 1]" line2="    const REG_ADDRESS = 0x30;    // רגיסטר לקריאה דיגיטלית[cite: 1]" line3="" line4="    /**" line5="     * מחזיר אמת אם כל החיישנים שדולקים יוצרים רצף אחיד וצמוד ללא פערים, ושקר אם יש הפרשים או נתקים." line6="     */" line7="    //% block=&quot;האם החיישנים הדלוקים צמודים ברצף?&quot;" line8="    //% weight=30" line9="    export function isContinuousLine(): boolean {" line10="        let data3 = readRawData();" line11="        if (data3 === 0) return false;" line12="" line13="        let first = -1;" line14="        let last = -1;" line15="        let activeCount = 0;" line16="" line17="        for (let i = 0; i &lt; 8; i++) {" line18="            let val2 = (data3 &gt;&gt; (7 - i)) &amp; 0x01;" line19="            if (val2 === 1) {" line20="                if (first === -1) {" line21="                    first = i;" line22="                }" line23="                last = i;" line24="                activeCount++;" line25="            }" line26="        }" line27="" line28="        let expectedCount = (last - first) + 1;" line29="        return activeCount === expectedCount;" line30="    }" line31="" line32="    /**" line33="     * מחשב את מרכז הקו (ממוצע מיקומי החיישנים הפעילים). " line34="     * לדוגמה, אם חיישנים 6, 7 ו-8 רואים קו, יחזיר את המספר 7. אם אין קו, יחזיר 0." line35="     */" line36="    //% block=&quot;מרכז הקו&quot;" line37="    //% weight=40" line38="    export function getLineCenter(): number {" line39="        let data4 = readRawData();" line40="        let sumIndex = 0;" line41="        let count = 0;" line42="" line43="        for (let j = 1; j &lt;= 8; j++) {" line44="            let val3 = (data4 &gt;&gt; (8 - j)) &amp; 0x01;" line45="            if (val3 === 1) {" line46="                sumIndex += j;" line47="                count++;" line48="            }" line49="        }" line50="" line51="        if (count === 0) {" line52="            return 0; // אין קו" line53="        }" line54="        return Math.round(sumIndex / count);" line55="    }" line56="" line57="    /**" line58="     * מחזיר אמת (True) אם הרובוט מזהה קו בכלל, או שקר (False) אם איבד את הקו" line59="     */" line60="    //% block=&quot;האם זוהה קו?&quot;" line61="    //% weight=60" line62="    export function isLineDetected(): boolean {" line63="        return readRawData() &gt; 0;" line64="    }" line65="" line66="    /**" line67="     * בודק כמה חיישנים מתוך ה-8 רואים קו כרגע (מחזיר מספר בין 0 ל-8)" line68="     */" line69="    //% block=&quot;כמות החיישנים שרואים קו&quot;" line70="    //% weight=50" line71="    export function countActiveSensors(): number {" line72="        let data5 = readRawData();" line73="        let count2 = 0;" line74="        for (let k = 0; k &lt; 8; k++) {" line75="            if ((data5 &gt;&gt; k) &amp; 0x01) {" line76="                count2++;" line77="            }" line78="        }" line79="        return count2;" line80="    }" line81="" line82="    /**" line83="     * מדפיס בצורה מסודרת בעברית למוניטור הטורי את מצב כל 8 החיישנים" line84="     */" line85="    //% block=&quot;הצג את מצב החיישנים&quot;" line86="    //% weight=90" line87="    export function printStatusSerial(): void {" line88="        let data6 = readRawData();" line89="        let text = &quot;מצב חיישנים (1-8): &quot;;" line90="        for (let l = 1; l &lt;= 8; l++) {" line91="            let val4 = (data6 &gt;&gt; (8 - l)) &amp; 0x01;" line92="            text += &quot;ח&quot; + l + &quot;:&quot; + val4 + &quot; &quot;;" line93="        }" line94="        serial.writeLine(text);" line95="    }" line96="" line97="    /**" line98="     * קרא את כל 8 החיישנים כבית בינארי שלם (0 עד 255)" line99="     */" line100="" line101="    export function readRawData(): number {" line102="        pins.i2cWriteNumber(" line103="            MODULE_ADDRESS," line104="            REG_ADDRESS," line105="            NumberFormat.UInt8BE," line106="            false" line107="        );" line108="        basic.pause(10); // השהייה הנדרשת לפי מפרט היצרן[cite: 1]" line109="        let buf2 = pins.i2cReadBuffer(MODULE_ADDRESS, 1, false);" line110="        return buf2[0];" line111="    }" line112="" line113="    /**" line114="     * מחזיר אמת אם חיישן ספציפי רואה קו, ושקר אם לא (בלוק בוליאני לתנאים)." line115="     * @param ch מספר החיישן בין 1 ל-8" line116="     */" line117="    //% block=&quot;האם חיישן מס' %ch רואה קו?&quot;" line118="    //% ch.min=1 ch.max=8 ch.defl=1" line119="    //% weight=70" line120="    export function isSensorActive(ch: number): boolean {" line121="        return readChannel(ch) === 1;" line122="    }" line123="" line124="    /**" line125="     * קרא את המצב של חיישן ספציפי (1 עד 8). מחזיר 0 (לבן) או 1 (שחור/קו)." line126="     * @param ch מספר החיישן בין 1 ל-8" line127="     */" line128="    //% block=&quot;קרא חיישן מס' %ch (1-8)&quot;" line129="    //% ch.min=1 ch.max=8 ch.defl=1" line130="    //% weight=80" line131="    export function readChannel(ch: number): number {" line132="        let data7 = readRawData();" line133="        if (ch &lt; 1) ch = 1;" line134="        if (ch &gt; 8) ch = 8;" line135="        let shift = 8 - ch;" line136="        return (data7 &gt;&gt; shift) &amp; 0x01;" line137="    }" line138="}" numlines="139"></mutation><next><block type="typescript_statement" id="Ny7EEv{^,M-hjP5cR7Kk"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace huskylensHebrew {" line1="" line2="    export enum AlgorithmMode {" line3="        //% block=&quot;זיהוי פנים&quot;" line4="        FaceRecognition = protocolAlgorithm.ALGORITHM_FACE_RECOGNITION," line5="        //% block=&quot;מעקב אחר עצם&quot;" line6="        ObjectTracking = protocolAlgorithm.ALGORITHM_OBJECT_TRACKING," line7="        //% block=&quot;זיהוי עצמים&quot;" line8="        ObjectRecognition = protocolAlgorithm.ALGORITHM_OBJECT_RECOGNITION," line9="        //% block=&quot;מעקב אחר קו&quot;" line10="        LineTracking = protocolAlgorithm.ALGORITHM_LINE_TRACKING," line11="        //% block=&quot;זיהוי צבעים&quot;" line12="        ColorRecognition = protocolAlgorithm.ALGORITHM_COLOR_RECOGNITION," line13="        //% block=&quot;זיהוי תגיות (QR)&quot;" line14="        TagRecognition = protocolAlgorithm.ALGORITHM_TAG_RECOGNITION" line15="    }" line16="" line17="    export enum TargetProperty {" line18="        //% block=&quot;מרכז X&quot;" line19="        XCenter = Content1.xCenter," line20="        //% block=&quot;מרכז Y&quot;" line21="        YCenter = Content1.yCenter," line22="        //% block=&quot;רוחב&quot;" line23="        Width = Content1.width," line24="        //% block=&quot;גובה&quot;" line25="        Height = Content1.height" line26="    }" line27="" line28="    /**" line29="     * אתחול המצלמה בתקשורת I2C" line30="     */" line31="    //% block=&quot;אתחל מצלמת האסקי&quot;" line32="    //% weight=100" line33="    export function init(): void {" line34="        huskylens.initI2c();" line35="    }" line36="" line37="    /**" line38="     * קביעת מצב הפעולה / האלגוריתם של המצלמה" line39="     * @param mode מצב הפעולה שנבחר" line40="     */" line41="    //% block=&quot;הגדר מצב מצלמה ל- %mode&quot;" line42="    //% weight=95" line43="    export function setMode(mode: AlgorithmMode): void {" line44="        // המרת טיפוס כדי למנוע את שגיאה 291" line45="        huskylens.initMode(mode as any as protocolAlgorithm);" line46="    }" line47="" line48="    /**" line49="     * בקשת נתונים עדכניים מהמצלמה (חובה לשים בתוך בלולאת 'לעולמים')" line50="     */" line51="    //% block=&quot;עדכן נתונים מהמצלמה&quot;" line52="    //% weight=90" line53="    export function requestData(): void {" line54="        huskylens.request();" line55="    }" line56="" line57="    /**" line58="     * בדיקה האם מטרה ספציפית נלמדה במצלמה" line59="     * @param id מזהה המטרה (ID)" line60="     */" line61="    //% block=&quot;האם מטרה %id נלמדה במצלמה?&quot;" line62="    //% id.defl=1" line63="    //% weight=85" line64="    export function isLearned(id: number): boolean {" line65="        return huskylens.isLearned(id);" line66="    }" line67="" line68="    /**" line69="     * בדיקה האם מטרה ספציפית מופיעה כרגע על המסך" line70="     * @param id מזהה המטרה (ID)" line71="     */" line72="    //% block=&quot;האם מטרה %id מופיעה על המסך?&quot;" line73="    //% id.defl=1" line74="    //% weight=80" line75="    export function isTargetVisible(id: number): boolean {" line76="        return huskylens.isAppear(id, HUSKYLENSResultType_t.HUSKYLENSResultBlock);" line77="    }" line78="" line79="    /**" line80="     * קריאת ערך מיקום/גודל של מטרה מסוימת לפי ה-ID שלה" line81="     * @param id מזהה המטרה" line82="     * @param prop המאפיין המבוקש (X, Y, רוחב, גובה)" line83="     */" line84="    //% block=&quot;קבל ממטרה %id את %prop&quot;" line85="    //% id.defl=1" line86="    //% weight=75" line87="    export function readTargetProperty(id: number, prop: TargetProperty): number {" line88="        // המרת טיפוס כדי למנוע את שגיאה 334" line89="        return huskylens.readeBox(id, prop as any as Content1);" line90="    }" line91="" line92="    /**" line93="     * קריאת מספר ה-ID של העצם שנמצא במרכז המסך" line94="     */" line95="    //% block=&quot;מספר ID של העצם במרכז המסך&quot;" line96="    //% weight=70" line97="    export function getCenterBoxID(): number {" line98="        return huskylens.readBox_s(Content3.ID);" line99="    }" line100="" line101="    /**" line102="     * קריאת מספר ה-ID של המטרה ה-N מתוך רשימת המטרות שנראות כרגע" line103="     * @param index מספר המטרה (אינדקס 1 ומעלה)" line104="     */" line105="    //% block=&quot;מספר ID של מטרה מס' %index שנראית כרגע&quot;" line106="    //% index.defl=1" line107="    //% weight=65" line108="    export function getNthBoxID(index: number): number {" line109="        return huskylens.readBox_ss(index, Content3.ID);" line110="    }" line111="}" numlines="112"></mutation></block></next></block></next></block></statement></block></xml>