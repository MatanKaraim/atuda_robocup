<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="r6%ckx*:lOGct=};(pz:" x="794" y="0"><statement name="HANDLER"><block type="typescript_statement" id="6:ut9KPwGGZZBsvo;dr?"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace huskylens {" line1="}" numlines="2"></mutation><next><block type="typescript_statement" id="knMckoSoK!x%]{CHEnk}"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace paj7620 {" line1="    const PAJ7620_I2C_ADDR = 0x73;" line2="    const PAJ7620_REGISTER_BANK_SEL = 0xEF;" line3="    const PAJ7620_BANK0 = 0x00;" line4="    const PAJ7620_BANK1 = 0x01;" line5="" line6="    // מערך אתחול רגיסטרים מלא מחומרת DFRobot PAJ7620U2" line7="    const INIT_ARRAY: number[][] = [" line8="        [0xEF, 0x00], [0x32, 0x29], [0x33, 0x01], [0x34, 0x00], [0x35, 0x01]," line9="        [0x36, 0x00], [0x37, 0x07], [0x38, 0x17], [0x39, 0x06], [0x3A, 0x12]," line10="        [0x3F, 0x00], [0x40, 0x00], [0x41, 0xFF], [0x42, 0x01], [0x46, 0x2D]," line11="        [0x47, 0x0F], [0x48, 0x3C], [0x49, 0x00], [0x4A, 0x1E], [0x4C, 0x20]," line12="        [0x4D, 0x00], [0x4E, 0x1A], [0x4F, 0x14], [0x50, 0x3F], [0x51, 0x3F]," line13="        [0x52, 0x00], [0x54, 0x00], [0x55, 0xC7], [0x56, 0x01], [0x57, 0x12]," line14="        [0x58, 0x05], [0x59, 0x05], [0x5A, 0x02], [0x5B, 0x03], [0x5C, 0x08]," line15="        [0x5D, 0x0A], [0x5E, 0x03], [0x5F, 0x21], [0x60, 0x0F], [0x61, 0x0A]," line16="        [0x62, 0x05], [0x63, 0x14], [0x65, 0x0B], [0x66, 0x0B], [0x67, 0x05]," line17="        [0x68, 0x05], [0x69, 0x05], [0x6A, 0x02], [0x6B, 0x08], [0x6C, 0x04]," line18="        [0x6D, 0x20], [0x6E, 0x10], [0x6F, 0x08], [0x70, 0x04], [0x71, 0x0C]," line19="        [0x72, 0x10], [0x73, 0x08], [0x74, 0x07], [0x75, 0x07], [0x77, 0x01]," line20="        [0x81, 0x56], [0x82, 0x04], [0x83, 0x30], [0x84, 0x20], [0x86, 0xA0]," line21="        [0x87, 0x78], [0x88, 0x01], [0x89, 0x55], [0x8A, 0x55], [0x8B, 0x01]," line22="        [0x8C, 0x3C], [0x8D, 0x3C], [0x8E, 0x00], [0x8F, 0x1A], [0x90, 0x40]," line23="        [0x91, 0x00], [0x92, 0x02], [0x93, 0x00], [0x94, 0x04], [0x95, 0x05]," line24="        [0x96, 0x01], [0x97, 0x05], [0x98, 0x05], [0x99, 0x05], [0x9A, 0x14]," line25="        [0x9C, 0x3F], [0x9D, 0x33], [0x9E, 0xAE], [0x9F, 0xF9], [0xA0, 0x48]," line26="        [0xA1, 0x13], [0xA2, 0x10], [0xA3, 0x08], [0xA4, 0x30], [0xA5, 0x24]," line27="        [0xA6, 0x14], [0xA7, 0x08], [0xA8, 0x24], [0xA9, 0x1C], [0xAA, 0x0C]," line28="        [0xAB, 0x08], [0xCC, 0x19], [0xCD, 0x0B], [0xCE, 0x13], [0xCF, 0x64]," line29="        [0xD0, 0x21], [0xEF, 0x01], [0x02, 0x0F], [0x03, 0x10], [0x04, 0x02]," line30="        [0x25, 0x01], [0x27, 0x39], [0x28, 0x7F], [0x29, 0x08], [0x3E, 0xFF]," line31="        [0x5E, 0x3D], [0x65, 0x96], [0x67, 0x97], [0x69, 0xCD], [0x6A, 0x01]," line32="        [0x6D, 0x2C], [0x6E, 0x01], [0x72, 0x01], [0x73, 0x35], [0x74, 0x00]," line33="        [0x77, 0x01], [0xEF, 0x00]" line34="    ];" line35="" line36="    export enum GestureType {" line37="        //% block=&quot;ללא&quot;" line38="        None = 0," line39="        //% block=&quot;ימינה&quot;" line40="        Right = 0x01," line41="        //% block=&quot;שמאלה&quot;" line42="        Left = 0x02," line43="        //% block=&quot;למעלה&quot;" line44="        Up = 0x04," line45="        //% block=&quot;למטה&quot;" line46="        Down = 0x08," line47="        //% block=&quot;קדימה&quot;" line48="        Forward = 0x10," line49="        //% block=&quot;אחורה&quot;" line50="        Backward = 0x20," line51="        //% block=&quot;בכיוון השעון&quot;" line52="        Clockwise = 0x40," line53="        //% block=&quot;נגד כיוון השעון&quot;" line54="        CounterClockwise = 0x80," line55="        //% block=&quot;נפנוף&quot;" line56="        Wave = 0x100" line57="    }" line58="" line59="    function writeReg(addr: number, val: number): void {" line60="        let buf = pins.createBuffer(2);" line61="        buf[0] = addr;" line62="        buf[1] = val;" line63="        pins.i2cWriteBuffer(PAJ7620_I2C_ADDR, buf, false);" line64="    }" line65="" line66="    function readReg(addr: number): number {" line67="        pins.i2cWriteNumber(PAJ7620_I2C_ADDR, addr, NumberFormat.UInt8BE, true);" line68="        return pins.i2cReadNumber(PAJ7620_I2C_ADDR, NumberFormat.UInt8BE, false);" line69="    }" line70="" line71="    /**" line72="     * מאתחל את חיישן המחוות PAJ7620U2" line73="     */" line74="    //% block=&quot;אתחל חיישן מחוות PAJ7620&quot;" line75="    //% weight=100" line76="    export function init(): boolean {" line77="        basic.pause(400); // המתנה להתייצבות מתח" line78="        writeReg(PAJ7620_REGISTER_BANK_SEL, PAJ7620_BANK0);" line79="" line80="        // בדיקת תקינות רכיב" line81="        let partIdLow = readReg(0x00);" line82="        let partIdHigh = readReg(0x01);" line83="        let partId = (partIdHigh &lt;&lt; 8) | partIdLow;" line84="        if (partId !== 0x7620) {" line85="            return false;" line86="        }" line87="" line88="        // טעינת מערך הגדרות יצרן" line89="        for (let i = 0; i &lt; INIT_ARRAY.length; i++) {" line90="            writeReg(INIT_ARRAY[i][0], INIT_ARRAY[i][1]);" line91="        }" line92="" line93="        writeReg(PAJ7620_REGISTER_BANK_SEL, PAJ7620_BANK0);" line94="        return true;" line95="    }" line96="" line97="    /**" line98="     * מחזיר את סוג התנועה שזוהתה" line99="     */" line100="    //% block=&quot;תנועה שזוהתה בחיישן המחוות&quot;" line101="    //% weight=90" line102="    export function getGesture(): GestureType {" line103="        writeReg(PAJ7620_REGISTER_BANK_SEL, PAJ7620_BANK0);" line104="        let flag0 = readReg(0x43);" line105="        let flag1 = readReg(0x44);" line106="        let val = flag0 | (flag1 &lt;&lt; 8);" line107="" line108="        if (val &amp; GestureType.Right) return GestureType.Right;" line109="        if (val &amp; GestureType.Left) return GestureType.Left;" line110="        if (val &amp; GestureType.Up) return GestureType.Up;" line111="        if (val &amp; GestureType.Down) return GestureType.Down;" line112="        if (val &amp; GestureType.Forward) return GestureType.Forward;" line113="        if (val &amp; GestureType.Backward) return GestureType.Backward;" line114="        if (val &amp; GestureType.Clockwise) return GestureType.Clockwise;" line115="        if (val &amp; GestureType.CounterClockwise) return GestureType.CounterClockwise;" line116="        if (val &amp; GestureType.Wave) return GestureType.Wave;" line117="" line118="        return GestureType.None;" line119="    }" line120="" line121="    /**" line122="     * בודק האם תנועה מסוימת זוהתה" line123="     * @param gesture סוג התנועה" line124="     */" line125="    //% block=&quot;האם זוהתה תנועה %gesture&quot;" line126="    //% weight=85" line127="    export function isGesture(gesture: GestureType): boolean {" line128="        return getGesture() === gesture;" line129="    }" line130="}" numlines="131"></mutation><next><block type="typescript_statement" id="IHuKe!;s(V0OB?}TG+iY"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace yahboomTracker {" line1="    const MODULE_ADDRESS = 0x12;" line2="    const REG_ADDRESS = 0x30;" line3="" line4="    export function readRawData(): number {" line5="        pins.i2cWriteNumber(MODULE_ADDRESS, REG_ADDRESS, NumberFormat.UInt8BE, false);" line6="        basic.pause(10);" line7="        let buf2 = pins.i2cReadBuffer(MODULE_ADDRESS, 1, false);" line8="        return buf2[0];" line9="    }" line10="" line11="    /**" line12="     * מחזיר אמת אם כל החיישנים הפעילים צמודים ברצף ללא פערים" line13="     */" line14="    //% block=&quot;האם החיישנים הדלוקים צמודים ברצף?&quot;" line15="    //% weight=30" line16="    export function isContinuousLine(): boolean {" line17="        let data = readRawData();" line18="        if (data === 0) return false;" line19="" line20="        let first = -1;" line21="        let last = -1;" line22="        let activeCount = 0;" line23="" line24="        for (let j = 0; j &lt; 8; j++) {" line25="            let val2 = (data &gt;&gt; (7 - j)) &amp; 0x01;" line26="            if (val2 === 1) {" line27="                if (first === -1) first = j;" line28="                last = j;" line29="                activeCount++;" line30="            }" line31="        }" line32="" line33="        let expectedCount = (last - first) + 1;" line34="        return activeCount === expectedCount;" line35="    }" line36="" line37="    /**" line38="     * מחשב את ממוצע מיקומי החיישנים הפעילים (1 עד 8, 0 אם אין קו)" line39="     */" line40="    //% block=&quot;מרכז הקו&quot;" line41="    //% weight=40" line42="    export function getLineCenter(): number {" line43="        let data2 = readRawData();" line44="        let sumIndex = 0;" line45="        let count = 0;" line46="" line47="        for (let k = 1; k &lt;= 8; k++) {" line48="            let val3 = (data2 &gt;&gt; (8 - k)) &amp; 0x01;" line49="            if (val3 === 1) {" line50="                sumIndex += k;" line51="                count++;" line52="            }" line53="        }" line54="" line55="        if (count === 0) return 0;" line56="        return Math.round(sumIndex / count);" line57="    }" line58="" line59="    /**" line60="     * בודק האם זוהה קו כלשהו" line61="     */" line62="    //% block=&quot;האם זוהה קו?&quot;" line63="    //% weight=60" line64="    export function isLineDetected(): boolean {" line65="        return readRawData() &gt; 0;" line66="    }" line67="" line68="    /**" line69="     * סופר כמה חיישנים מזהים קו כרגע (0 עד 8)" line70="     */" line71="    //% block=&quot;כמות החיישנים שרואים קו&quot;" line72="    //% weight=50" line73="    export function countActiveSensors(): number {" line74="        let data3 = readRawData();" line75="        let count2 = 0;" line76="        for (let l = 0; l &lt; 8; l++) {" line77="            if ((data3 &gt;&gt; l) &amp; 0x01) {" line78="                count2++;" line79="            }" line80="        }" line81="        return count2;" line82="    }" line83="" line84="    /**" line85="     * מדפיס את מצב 8 החיישנים לערוץ הטורי (Serial)" line86="     */" line87="    //% block=&quot;הצג את מצב החיישנים במוניטור&quot;" line88="    //% weight=90" line89="    export function printStatusSerial(): void {" line90="        let data4 = readRawData();" line91="        let text = &quot;Sensors (1-8): &quot;;" line92="        for (let m = 1; m &lt;= 8; m++) {" line93="            let val4 = (data4 &gt;&gt; (8 - m)) &amp; 0x01;" line94="            text += &quot;S&quot; + m + &quot;:&quot; + val4 + &quot; &quot;;" line95="        }" line96="        serial.writeLine(text);" line97="    }" line98="" line99="    /**" line100="     * קורא ערך של ערוץ בודד (1 עד 8)" line101="     * @param ch מספר ערוץ" line102="     */" line103="    //% block=&quot;קרא חיישן מספר %ch&quot;" line104="    //% ch.min=1 ch.max=8 ch.defl=1" line105="    //% weight=80" line106="    export function readChannel(ch: number): number {" line107="        let data5 = readRawData();" line108="        ch = Math.clamp(1, 8, ch);" line109="        let shift = 8 - ch;" line110="        return (data5 &gt;&gt; shift) &amp; 0x01;" line111="    }" line112="" line113="    /**" line114="     * בודק האם חיישן מסוים רואה קו (בוליאני)" line115="     * @param ch מספר חיישן" line116="     */" line117="    //% block=&quot;האם חיישן מספר %ch רואה קו?&quot;" line118="    //% ch.min=1 ch.max=8 ch.defl=1" line119="    //% weight=70" line120="    export function isSensorActive(ch: number): boolean {" line121="        return readChannel(ch) === 1;" line122="    }" line123="}" numlines="124"></mutation><next><block type="typescript_statement" id="c%{(6x;8a(#VEj$!/0oX"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace huskylensHebrew {" line1="" line2="    export enum AlgorithmMode {" line3="        //% block=&quot;זיהוי פנים&quot;" line4="        FaceRecognition = protocolAlgorithm.ALGORITHM_FACE_RECOGNITION," line5="        //% block=&quot;מעקב אחר עצם&quot;" line6="        ObjectTracking = protocolAlgorithm.ALGORITHM_OBJECT_TRACKING," line7="        //% block=&quot;זיהוי עצמים&quot;" line8="        ObjectRecognition = protocolAlgorithm.ALGORITHM_OBJECT_RECOGNITION," line9="        //% block=&quot;מעקב אחר קו&quot;" line10="        LineTracking = protocolAlgorithm.ALGORITHM_LINE_TRACKING," line11="        //% block=&quot;זיהוי צבעים&quot;" line12="        ColorRecognition = protocolAlgorithm.ALGORITHM_COLOR_RECOGNITION," line13="        //% block=&quot;זיהוי תגיות (QR)&quot;" line14="        TagRecognition = protocolAlgorithm.ALGORITHM_TAG_RECOGNITION" line15="    }" line16="" line17="    export enum TargetProperty {" line18="        //% block=&quot;מרכז אופקי (X)&quot;" line19="        XCenter = Content1.xCenter," line20="        //% block=&quot;מרכז אנכי (Y)&quot;" line21="        YCenter = Content1.yCenter," line22="        //% block=&quot;רוחב&quot;" line23="        Width = Content1.width," line24="        //% block=&quot;גובה&quot;" line25="        Height = Content1.height" line26="    }" line27="" line28="    export enum ArrowProperty {" line29="        //% block=&quot;התחלה אופקית (X)&quot;" line30="        XOrigin = Content2.xOrigin," line31="        //% block=&quot;התחלה אנכית (Y)&quot;" line32="        YOrigin = Content2.yOrigin," line33="        //% block=&quot;סיום אופקי (X)&quot;" line34="        XTarget = Content2.xTarget," line35="        //% block=&quot;סיום אנכי (Y)&quot;" line36="        YTarget = Content2.yTarget" line37="    }" line38="" line39="    export enum ResultType {" line40="        //% block=&quot;מסגרת&quot;" line41="        Frame = HUSKYLENSResultType_t.HUSKYLENSResultBlock," line42="        //% block=&quot;חץ&quot;" line43="        Arrow = HUSKYLENSResultType_t.HUSKYLENSResultArrow" line44="    }" line45="" line46="    // ==========================================" line47="    // בלוקים ראשיים" line48="    // ==========================================" line49="" line50="    //% group=&quot;אתחול והגדרות&quot;" line51="    //% block=&quot;אתחל תקשורת עם מצלמת האסקי&quot;" line52="    //% weight=100" line53="    export function initI2C(): void {" line54="        huskylens.initI2c();" line55="    }" line56="" line57="    //% group=&quot;אתחול והגדרות&quot;" line58="    //% block=&quot;החלף מצב אלגוריתם ל %mode&quot;" line59="    //% weight=95" line60="    export function switchAlgorithm(mode: AlgorithmMode): void {" line61="        huskylens.initMode(mode as number as protocolAlgorithm);" line62="    }" line63="" line64="    //% group=&quot;קריאת נתונים ובדיקות&quot;" line65="    //% block=&quot;בקש נתונים פעם אחת ושמור בזיכרון&quot;" line66="    //% weight=90" line67="    export function requestData(): void {" line68="        huskylens.request();" line69="    }" line70="" line71="    //% group=&quot;קריאת נתונים ובדיקות&quot;" line72="    //% block=&quot;כמות המטרות שנלמדו בסך הכל&quot;" line73="    //% weight=88" line74="    export function getLearnedIDsCount(): number {" line75="        return huskylens.getIds();" line76="    }" line77="" line78="    //% group=&quot;קריאת נתונים ובדיקות&quot;" line79="    //% block=&quot;האם %ht מופיע על המסך?&quot;" line80="    //% weight=86" line81="    export function isTypeOnScreen(ht: ResultType): boolean {" line82="        return huskylens.isAppear_s(ht as number as HUSKYLENSResultType_t);" line83="    }" line84="" line85="    //% group=&quot;עצם במרכז המסך&quot;" line86="    //% block=&quot;מחץ הקרוב ביותר למרכז המסך קבל את %prop&quot;" line87="    //% weight=84" line88="    export function getCenterArrowData(prop: ArrowProperty): number {" line89="        return huskylens.readArrow_s(prop as number as Content4);" line90="    }" line91="" line92="    //% group=&quot;עצם במרכז המסך&quot;" line93="    //% block=&quot;ממסגרת הקרובה ביותר למרכז המסך קבל את %prop&quot;" line94="    //% weight=82" line95="    